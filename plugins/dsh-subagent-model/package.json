{
  "name": "@dsh-external/dsh-subagent-model",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "DSH subagent model settings: pin provider / model / reasoningEffort for subagent & subagent_fork from the Web UI. Sentinel-managed block in the profile cordis.patch.yml, byte-identical content outside the block, automatic backups, settings.yaml read-only.",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "license": "BSD-3-Clause",
  "peerDependencies": {
    "@deepseek-ai/dsh-client-runtime": "*",
    "@deepseek-ai/dsh-host-webserver": "*",
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-client-ui-slots": "*",
    "@deepseek-ai/dsh-client-ui-settings": "*",
    "@deepseek-ai/dsh-client-locale": "*",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "scripts": {
    "build": "node --check lib/index.js && node --check lib/store.js && node --check lib/client.js && node --check lib/catalog.js",
    "prepack": "npm run build",
    "check": "node tests/unit.mjs"
  }
}
